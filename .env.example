# ============================================================
#  CONTOH ENVIRONMENT VARIABLES — Product Knowledge
#  Salin ke Vercel: Project Settings > Environment Variables
#  Untuk lokal: salin file ini jadi .env.local
# ============================================================
#
#  Tidak ada kredensial Google di sini. Datanya tinggal di folder data/
#  sebagai file TypeScript, ikut ter-bundle saat build.

# 1) PIN gerbang aplikasi.
#    Isinya riset dan contoh soal internal, jadi JANGAN dibiarkan terbuka.
#    Kosongkan hanya untuk jalan di lokal.
VIEW_PIN=

# 2) Garam penanda tangan cookie sesi. Teks acak, minimal 16 karakter.
#    Bikin acak:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PIN_SALT=
